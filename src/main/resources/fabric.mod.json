{
  "schemaVersion": 1,
  "id": "whereismyshulker",
  "version": "${version}",
  "name": "WhereIsMyShulker",
  "description": "Tracks the location of shulker boxes that are currently placed in the world.",
  "authors": ["TheMcSebi"],
  "contact": {
    "sources": "https://github.com/TheMcSebi/whereismyshulker",
    "homepage": "https://modrinth.com/mod/where-is-my-shulker",
    "issues": "https://github.com/TheMcSebi/whereismyshulker/issues"
  },
  "license": "GNU General Public License, Version 3",
  "icon": "assets/whereismyshulker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.mcsebi.whereismyshulker.client.WhereismyshulkerClient"
    ]
  },
  "mixins": [
    {
      "config": "whereismyshulker.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
